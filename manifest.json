{
  "manifest_version": 3,
  "name": "DOM-SCOUT",
  "version": "1.0.0",
  "description": "Select DOM elements and copy AI-ready representations to clipboard. Stop sending screenshots - send structure.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "commands"
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "DOM-SCOUT: Select & Copy DOM for AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/constants.js",
        "lib/dom-cleaner.js",
        "lib/css-extractor.js",
        "lib/token-counter.js",
        "lib/serializer.js",
        "lib/formatter.js",
        "content/highlighter.js",
        "content/inspector.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-inspector": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Toggle DOM Scout inspector on/off"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "content/content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
